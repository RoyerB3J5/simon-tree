---
import ProfileIdentity from '../../components/ProfileIdentity.astro';
import ReviewInteractions from '../../components/ReviewInteractions.astro';
import FormReview from '../../components/FormReview.astro';
import { googleReviewUrl } from '../../data/review';

const icon = (name: string) => `/icons/shapehub-1/review-${name}.svg`;
const starShapes = [1, 2, 3, 3, 1];
const actionClass = 'flex h-12 w-full items-center justify-center gap-2 rounded-xl px-4 text-[15px] font-semibold text-primary-action-ink no-underline shadow-[var(--control-shadow)] [background:var(--action-primary)]';
---
<div data-review data-google-min-rating="4" class="grid gap-4 text-[#022b02]">
<article class="rounded-2xl bg-white px-4 py-4">
  <div class="flex items-center justify-between gap-2 text-[15px]">
    <p class="flex items-center gap-2"><img src={icon('google')} width="16" height="16" alt="" />Google Reviews</p>
    <p class="flex items-center gap-1"><img src={icon('score')} width="12" height="11" alt="" /><span>5.0</span></p>
  </div>

  <div class="mt-6"><ProfileIdentity theme="shapehub" /></div>
  <hr class="mt-3 border-0 border-t border-[#022b02]/10" />

  <div class="mt-6 grid justify-items-center gap-4 text-center">
    <h1 class="text-2xl leading-[1.2] font-bold" style="max-width: 260px">How would you rate our service?</h1>
    <p class="text-[15px] leading-[1.5]">Your opinion helps keep our neighborhood safe, trimmed, and green.</p>
    <fieldset class="business-rating flex max-w-full items-center justify-center">
      <legend class="sr-only">How would you rate our service?</legend>
      {starShapes.map((shape, index) => {
        const value = index + 1;
        const outline = icon(`star-${shape}-outline`);
        const filled = icon(`star-${shape}`);
        return <label class="flex shrink-0 cursor-pointer items-center justify-center rounded-sm">
          <input class="sr-only" type="radio" name="rating" value={value} aria-label={`${value} ${value === 1 ? 'star' : 'stars'}`} />
          <img data-rating-star data-filled-src={filled} data-outline-src={outline} src={outline} width="26" height="24" alt="" />
        </label>;
      })}
    </fieldset>
  </div>

    <p data-rating-badge class="mt-5 flex items-center justify-center gap-2 rounded-[18px] border border-[#034812] px-2 py-2 text-center text-xs font-semibold uppercase" hidden>
      <img src={icon('excellent')} width="16" height="16" alt="" /><span data-rating-score>5.0 Excellent / Outstanding Experience</span>
    </p>
  <div data-feedback-widget class="mt-6" hidden><FormReview /></div>
</article>
  <div data-five-star-content class="grid gap-4" hidden>
    <section data-review-suggestion class="grid gap-5 rounded-2xl bg-white px-4 py-6" aria-labelledby="review-suggestion-heading">
      <div class="flex items-center gap-4">
        <img src="/icons/shapehub/review-message.svg" width="40" height="40" alt="" class="shrink-0" />
        <div class="min-w-0 border-l border-[#a5d33d] pl-4">
          <h2 id="review-suggestion-heading" class="text-xl leading-[1.2] font-bold">Need a review suggestion?</h2>
          <p class="mt-4 text-[15px] leading-[1.5]">Here’s a suggestion to copy if it fits your experience.</p>
        </div>
      </div>
      <textarea data-review-text aria-label="Review suggestion" rows="3" class="min-h-[90px] w-full resize-none rounded-lg border border-[#c8ccd0] bg-white p-4 text-[15px] leading-[1.5] italic text-[#022b02] focus:border-[#a5d33d] focus:outline-2 focus:outline-offset-0 focus:outline-[#a5d33d]"></textarea>
      <div class="grid grid-cols-2 gap-4">
        <button data-regenerate-review type="button" class="flex h-12 min-w-0 items-center justify-center gap-2 rounded-xl border-2 border-[#a5d33d] bg-white px-2 text-[15px] font-semibold shadow-[var(--control-shadow)]">
          <span class="flex size-6 shrink-0 items-center justify-center"><img src="/icons/shapehub/review-regenerate.svg" width="21.8262" height="16.6023" alt="" /></span><span>Regenerate</span>
        </button>
        <button data-copy-review type="button" class="flex h-12 min-w-0 items-center justify-center gap-2 rounded-xl bg-[#a5d33d] px-2 text-[15px] font-semibold shadow-[var(--control-shadow)]">
          <img src="/icons/shapehub/review-copy.svg" width="20" height="20" alt="" class="shrink-0" /><span>Copy text</span>
        </button>
      </div>
      <p data-copy-status class="text-[15px] empty:hidden" role="status" aria-live="polite"></p>
      <p class="text-center text-[15px] leading-[1.5]">*Review and edit before posting.</p>
    </section>
    {googleReviewUrl ? <a data-google-review class={actionClass} href={googleReviewUrl}>
      <img src={icon('google-action')} width="33" height="33" alt="" /><span>Continue to Google Review</span>
    </a> : <span data-google-review class={actionClass} role="link" aria-disabled="true">
      <img src={icon('google-action')} width="33" height="33" alt="" /><span>Continue to Google Review</span>
    </span>}
  </div>
</div>
<ReviewInteractions />

<style>
  .business-rating { gap: 24px; }
  .business-rating label { position: relative; width: 26px; height: 24px; }
  .business-rating label::before { content: ''; position: absolute; inset: -10px -11px; }
  .business-rating label:has(input:focus-visible) { outline: 2px solid #084e17; outline-offset: 2px; }

  .business-rating label:last-of-type img {
    transform-origin: 50% 90%;
    animation: fifth-star-bounce 1.2s ease-in-out infinite;
    will-change: transform;
  }

  .business-rating label:last-of-type:has(input:checked) img {
    animation: none;
    transform: none;
    will-change: auto;
  }

  @keyframes fifth-star-bounce {
    0%, 100% { transform: translateY(0) scale(1); }
    18% { transform: translateY(-7px) scale(1.26923, 1.29167); }
    36% { transform: translateY(0) scale(0.96, 1.04); }
    50% { transform: translateY(-3px) scale(1.02); }
    64% { transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .business-rating label:last-of-type img {
      animation: none;
    }
  }
</style>
