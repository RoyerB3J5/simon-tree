---
import { links, designIcon, type ShapehubTheme } from '../data/shapehub';
interface Props { theme: ShapehubTheme; }
const { theme } = Astro.props;
const social = links.slice(0, 3);
const actions = links.slice(3);
const socialClass = 'flex min-h-[87px] flex-col items-center justify-center gap-3 rounded-[var(--social-radius)] border border-[var(--control-border)] px-1 py-4 text-center font-semibold text-social-ink no-underline [background:var(--social-background)] first:[background:var(--social-first-background)] shadow-[var(--control-shadow)]';
const actionClass = 'flex h-14 items-center gap-2 rounded-[var(--action-radius)] border border-[var(--control-border)] px-4 font-semibold no-underline shadow-[var(--control-shadow)]';
---
<nav aria-label="Contact and social links" class="grid gap-3">
  <div class="grid grid-cols-3 gap-2">
    {social.map(({ label, href, icon }) => (
      href ? <a class={socialClass} href={href}>
        <img class="shrink-0" src={designIcon(theme, icon)} alt="" /><span class="text-trim">{label}</span>
      </a> : <span class={socialClass} role="link" aria-disabled="true">
        <img class="shrink-0" src={designIcon(theme, icon)} alt="" /><span class="text-trim">{label}</span>
      </span>
    ))}
  </div>
  <div class="grid gap-3">
    {actions.map(({ label, href, icon }, index) => {
      const variantClass = index === 1
        ? 'text-secondary-action-ink [background:var(--action-secondary)]'
        : 'text-primary-action-ink [background:var(--action-primary)]';
      return href ? <a class:list={[actionClass, variantClass]} href={href}>
        <img class="shrink-0" src={designIcon(theme, icon)} alt="" /><span>{label}</span><img class="ml-auto shrink-0" src={designIcon(theme, index === 1 ? 'arrow-secondary' : 'arrow-primary')} alt="" />
      </a> : <span class:list={[actionClass, variantClass]} role="link" aria-disabled="true">
        <img class="shrink-0" src={designIcon(theme, icon)} alt="" /><span>{label}</span><img class="ml-auto shrink-0" src={designIcon(theme, index === 1 ? 'arrow-secondary' : 'arrow-primary')} alt="" />
      </span>;
    })}
  </div>
</nav>
