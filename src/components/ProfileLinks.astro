---
import SocialLinks from './SocialLinks.astro';
import ContactAction from './ContactAction.astro';
import type { ShapehubTheme } from '../data/shapehub';
interface Props { theme: ShapehubTheme; }
const { theme } = Astro.props;
---
<nav aria-label="Contact and social links" class="grid gap-3">
  <SocialLinks theme={theme} />
  <ContactAction theme={theme} />
</nav>
