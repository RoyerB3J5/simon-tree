<script>
  import { reviewTexts } from '../data/review';

  for (const review of document.querySelectorAll<HTMLElement>('[data-review]')) {
    const ratings = review.querySelectorAll<HTMLInputElement>('input[name="rating"]');
    const stars = review.querySelectorAll<HTMLImageElement>('[data-rating-star]');
    const content = review.querySelector<HTMLElement>('[data-five-star-content]');
    const feedback = review.querySelector<HTMLElement>('[data-feedback-widget]');
    const scoreLabel = review.querySelector<HTMLElement>('[data-rating-score]');
    const badge = review.querySelector<HTMLElement>('[data-rating-badge]');
    const suggestion = review.querySelector<HTMLElement>('[data-review-suggestion]');
    const googleMinRating = Number(review.dataset.googleMinRating ?? 5);
    const text = review.querySelector<HTMLElement>('[data-review-text]');
    const copyButton = review.querySelector<HTMLButtonElement>('[data-copy-review]');
    const regenerateButton = review.querySelector<HTMLButtonElement>('[data-regenerate-review]');
    const status = review.querySelector<HTMLElement>('[data-copy-status]');
    const pendingAction = review.querySelector<HTMLElement>('[data-review-pending]');
    const googleAction = review.querySelector<HTMLElement>('[data-google-review]');
    if (!content || !text || !copyButton || !status) continue;

    let selectedIndex: number | undefined;
    const setText = (value: string) => {
      if (text instanceof HTMLTextAreaElement) text.value = value;
      else text.textContent = value;
    };
    const getText = () => text instanceof HTMLTextAreaElement ? text.value : text.textContent ?? '';
    const chooseSuggestion = () => {
      if (!reviewTexts.length) return;
      let index = Math.floor(Math.random() * reviewTexts.length);
      if (reviewTexts.length > 1 && index === selectedIndex) {
        index = (index + 1 + Math.floor(Math.random() * (reviewTexts.length - 1))) % reviewTexts.length;
      }
      selectedIndex = index;
      setText(reviewTexts[index]);
    };
    for (const rating of ratings) {
      rating.addEventListener('change', () => {
        const value = Number(rating.value);
        stars.forEach((star, index) => {
          const src = index < value ? star.dataset.filledSrc : star.dataset.outlineSrc;
          if (src) star.src = src;
        });
        const showGoogle = value >= googleMinRating;
        content.hidden = !showGoogle;
        if (badge) badge.hidden = !showGoogle;
        if (feedback) feedback.hidden = value < 1 || showGoogle;
        status.textContent = '';
        if (showGoogle) {
          if (scoreLabel) scoreLabel.textContent = value === 5 ? '5.0 Excellent / Outstanding Experience' : `${value}.0`;
          if (selectedIndex === undefined) chooseSuggestion();
          if (suggestion) {
            requestAnimationFrame(() => {
              suggestion.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
            });
          }
          if (pendingAction) {
            requestAnimationFrame(() => {
              const action = googleAction && !googleAction.hidden ? googleAction : pendingAction;
              action.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'end' });
            });
          }
        }
      });
    }

    regenerateButton?.addEventListener('click', () => {
      chooseSuggestion();
      status.textContent = '';
    });
    if (text instanceof HTMLTextAreaElement) text.addEventListener('input', () => { status.textContent = ''; });

    copyButton.addEventListener('click', async () => {
      const value = getText();
      if (!value) return;
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(value);
        status.textContent = 'Text copied.';
        if (pendingAction && googleAction) {
          pendingAction.hidden = true;
          googleAction.hidden = false;
        }
      } catch {
        if (text instanceof HTMLTextAreaElement) {
          text.focus();
          text.select();
        } else if (window.getSelection()) {
          const selection = window.getSelection()!;
          const range = document.createRange();
          range.selectNodeContents(text);
          selection.removeAllRanges();
          selection.addRange(range);
        }
        status.textContent = 'Copy unavailable. Select the text above and copy it manually.';
      }
    });
  }
</script>
